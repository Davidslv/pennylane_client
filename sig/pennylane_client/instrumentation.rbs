module PennylaneClient
  class Instrumentation
    type event = Hash[Symbol, untyped]

    def initialize: (?logger: untyped, ?on_request: (^(event) -> void)?) -> void

    def record: (event event) -> void

    private

    @logger: untyped
    @on_request: (^(event) -> void)?

    def guard: (?String prefix) { () -> void } -> void
    def report_failure: (String line) -> void
    def log: (event event) -> void
  end
end
