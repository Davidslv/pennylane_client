module PennylaneClient
  # Anything that turns a Request into a Response.
  interface _Transport
    def call: (Request request) -> Response
  end

  class NetHttpTransport
    include _Transport

    VERBS: Hash[Symbol, untyped]
    TIMEOUT_ERRORS: Array[untyped]
    CONNECTION_ERRORS: Array[untyped]
    DEFAULT: NetHttpTransport

    def self.default: () -> NetHttpTransport

    def initialize: (?open_timeout: Numeric, ?read_timeout: Numeric, ?write_timeout: Numeric,
                     ?upload_timeout: Numeric, ?keep_alive_timeout: Numeric) -> void

    def close: () -> void

    private

    @open_timeout: Numeric
    @read_timeout: Numeric
    @write_timeout: Numeric
    @upload_timeout: Numeric
    @keep_alive_timeout: Numeric
    @key: Symbol

    def exchange: (Request request, untyped uri) -> Response
    def send_request: (untyped http, Request request, untyped uri) -> untyped
    def stream?: (untyped body) -> bool

    def connections: () -> Hash[String, untyped]
    def connection: (untyped uri) -> untyped
    def build_connection: (untyped uri) -> untyped
    def build: (Request request, untyped uri) -> untyped
    def to_response: (untyped response) -> Response
    def fail_with: (singleton(Error) klass, Exception error, untyped uri) -> bot
    def drop: (untyped uri) -> void
    def finish: (untyped http) -> void
  end
end
