module PennylaneClient
  def self.new: (token: token, ?base_url: String, ?transport: _Transport, ?logger: untyped,
                 ?on_request: (^(Instrumentation::event) -> void)?, ?limiters: _LimiterRegistry,
                 ?max_retry_wait: Numeric) -> Client

  class Client
    DEFAULT_BASE_URL: String
    RETRY_POLICIES: Hash[Symbol?, :default | :always]

    def initialize: (token: token, ?base_url: String, ?transport: _Transport, ?logger: untyped,
                     ?on_request: (^(Instrumentation::event) -> void)?, ?limiters: _LimiterRegistry,
                     ?max_retry_wait: Numeric) -> void

    def call: (Symbol | String operation_id, ?untyped body, **untyped params) -> untyped

    def paginate: (Symbol | String operation_id, **untyped params) -> Enumerator::Lazy[Hash[Symbol, untyped], void]

    def pages: (Symbol | String operation_id, **untyped params) -> Enumerator::Lazy[Hash[Symbol, untyped], void]

    def customer_invoices: () -> Resources::CustomerInvoices

    def customers: () -> Resources::Customers

    def supplier_invoices: () -> Resources::SupplierInvoices

    def suppliers: () -> Resources::Suppliers

    def sepa_mandates: () -> Resources::SepaMandates

    def gocardless_mandates: () -> Resources::GocardlessMandates

    def pro_account_mandates: () -> Resources::ProAccountMandates

    def bank_accounts: () -> Resources::BankAccounts

    def bank_establishments: () -> Resources::BankEstablishments

    def transactions: () -> Resources::Transactions

    def quotes: () -> Resources::Quotes

    def commercial_documents: () -> Resources::CommercialDocuments

    def customer_invoice_templates: () -> Resources::CustomerInvoiceTemplates

    def numberings: () -> Resources::Numberings

    def journals: () -> Resources::Journals

    def fiscal_years: () -> Resources::FiscalYears

    def file_attachments: () -> Resources::FileAttachments

    def ledger_accounts: () -> Resources::LedgerAccounts

    def ledger_entries: () -> Resources::LedgerEntries

    def ledger_entry_lines: () -> Resources::LedgerEntryLines

    def trial_balance: () -> Resources::TrialBalance

    def categories: () -> Resources::Categories

    def category_groups: () -> Resources::CategoryGroups

    def products: () -> Resources::Products

    def changelogs: () -> Resources::Changelogs

    def exports: () -> Resources::Exports

    def billing_subscriptions: () -> Resources::BillingSubscriptions

    def inspect: () -> String

    private

    @customer_invoices: Resources::CustomerInvoices?

    @customers: Resources::Customers?

    @supplier_invoices: Resources::SupplierInvoices?

    @suppliers: Resources::Suppliers?

    @sepa_mandates: Resources::SepaMandates?

    @gocardless_mandates: Resources::GocardlessMandates?

    @pro_account_mandates: Resources::ProAccountMandates?

    @bank_accounts: Resources::BankAccounts?

    @bank_establishments: Resources::BankEstablishments?

    @transactions: Resources::Transactions?

    @quotes: Resources::Quotes?

    @commercial_documents: Resources::CommercialDocuments?

    @customer_invoice_templates: Resources::CustomerInvoiceTemplates?

    @numberings: Resources::Numberings?

    @journals: Resources::Journals?

    @fiscal_years: Resources::FiscalYears?

    @file_attachments: Resources::FileAttachments?

    @ledger_accounts: Resources::LedgerAccounts?

    @ledger_entries: Resources::LedgerEntries?

    @ledger_entry_lines: Resources::LedgerEntryLines?

    @trial_balance: Resources::TrialBalance?

    @categories: Resources::Categories?

    @category_groups: Resources::CategoryGroups?

    @products: Resources::Products?

    @changelogs: Resources::Changelogs?

    @exports: Resources::Exports?

    @billing_subscriptions: Resources::BillingSubscriptions?

    def paginator: (Symbol | String operation_id, Hash[Symbol, untyped] params) -> Paginator
  end
end
