module PennylaneClient
  # What RateLimit needs from a limiter; bring your own through LimiterRegistry.
  interface _Limiter
    def acquire: () -> Float
    def update: (remaining: Integer, ?reset_at: Float?) -> void
  end

  class Limiter
    include _Limiter

    def initialize: (?limit: Integer, ?period: Numeric, ?clock: ^() -> Float, ?sleeper: ^(Float) -> void) -> void

    def idle?: () -> bool

    def inspect: () -> String

    private

    @limit: Integer
    @period: Float
    @clock: ^() -> Float
    @sleeper: ^(Float) -> void
    @lock: Thread::Mutex
    @remaining: Integer
    @reset_at: Float?
    @waiting: Integer

    def sleep_for: (Float wait) -> void
    def take: () -> Float
    def plausible?: (Float reset_at, Float now) -> bool
    def refill: (Float now) -> void
  end
end
