module PennylaneClient
  # What RateLimit needs from a registry.
  interface _LimiterRegistry
    def fetch: (String key) -> _Limiter
  end

  class LimiterRegistry
    include _LimiterRegistry

    DEFAULT: LimiterRegistry
    IDLE_AFTER: Float

    def self.default: () -> LimiterRegistry

    def initialize: (?idle_after: Numeric, ?clock: ^() -> Float) ?{ (String key) -> _Limiter } -> void

    def inspect: () -> String

    private

    def touch: (String key) -> _Limiter?
    def store: (String key, _Limiter limiter) -> _Limiter
    def sweep: (Float now) -> void
    def idle?: (_Limiter limiter) -> bool
  end
end
