module PennylaneClient
  # A String token, or a provider returning the current one.
  type token = String | ^() -> String

  module Middleware
    class Auth
      include _Transport

      FORMAT: Regexp

      def initialize: (_Transport app, token token) -> void

      def inspect: () -> String
      def pretty_print: (untyped printer) -> untyped

      private

      def current_token: () -> String
      def valid?: (untyped token) -> bool
    end

    class RateLimit
      include _Transport

      def initialize: (_Transport app, _LimiterRegistry limiters, Instrumentation instrumentation) -> void

      private

      def key: (Request request) -> String
      def correct: (_Limiter limiter, Hash[String, String] headers) -> void
      def report: (Request request, Float waited) -> void
    end

    class Instrument
      include _Transport

      def initialize: (_Transport app, Instrumentation instrumentation) -> void

      private

      def report: (Request request, Float started, ?status: Integer?, ?error: String?) -> void
    end
  end
end
